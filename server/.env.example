# Alpaca Broker API — SANDBOX credentials
# Copy this file to `.env` (same folder) and paste your real values there.
# `.env` is git-ignored and never leaves your machine. Do NOT paste keys into chat.
#
# Get these from the BROKER dashboard (not the trading one):
#   https://broker-app.alpaca.markets  →  API/Devs → API Credentials → Generate API Key
#   Make sure the environment selector says SANDBOX.
#
# The dashboard calls these "CLIENT ID" and the secret it shows you ONCE at creation.
# Alpaca's Broker API uses the OAuth2 client-credentials flow: we exchange these for a
# short-lived access token at ALPACA_AUTH_URL, then call the API with a Bearer token.
# (Older key/secret HTTP-Basic auth is the "legacy" flow and 401s with these creds.)

ALPACA_CLIENT_ID=your_client_id_here
ALPACA_CLIENT_SECRET=your_client_secret_here

# Auth (token) host — sandbox. Live would be https://authx.alpaca.markets
ALPACA_AUTH_URL=https://authx.sandbox.alpaca.markets

# Broker API host — sandbox. Live would be https://broker-api.alpaca.markets
ALPACA_BASE_URL=https://broker-api.sandbox.alpaca.markets

# Filled in automatically by alpaca-create-account.mjs — leave blank at first.
ALPACA_TEST_ACCOUNT_ID=

# ── Plaid (real bank-transaction feed, and real deposits/withdrawals) ──────────
# Get sandbox keys at https://dashboard.plaid.com → Team Settings → Keys.
# Without these, the app keeps using the manual "Make a purchase" button.
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_secret_here
PLAID_ENV=sandbox

# ── Auto-fund switch ─────────────────────────────────────────────────────────
# Sandbox-only convenience: gift every new account $100 of OUR money so a demo
# works instantly, instead of requiring a real deposit via /api/deposit.
# NEVER set this to "1" in a real deployment — that hands every signup real
# company money. Leave unset (or "0") in production; the account starts at $0
# and the user funds it themselves from their own bank. See the "Real Deposits
# Build Spec" for the full flow.
AUTO_FUND_NEW_ACCOUNTS=1
