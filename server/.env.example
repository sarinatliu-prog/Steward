# Alpaca Broker API — SANDBOX credentials
# Copy this file to `.env` (same folder) and paste your real keys there.
# `.env` is git-ignored and never leaves your machine. Do NOT paste keys into chat.

# Get these from the Alpaca Broker dashboard (sandbox): https://broker-app.alpaca.markets/
ALPACA_API_KEY_ID=your_key_id_here
ALPACA_API_SECRET_KEY=your_secret_here

# Broker API sandbox base URL (leave as-is for sandbox)
ALPACA_BASE_URL=https://broker-api.sandbox.alpaca.markets
