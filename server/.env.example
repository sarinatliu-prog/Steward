# Steward — the ethical portfolio analyzer.
# Copy this file to `.env` (same folder) and fill in your values. `.env` is
# git-ignored and never leaves your machine. Do NOT paste keys into chat.

# ── SnapTrade (read-only brokerage connection) ──────────────────────────────
# Get keys at https://dashboard.snaptrade.com. The consumerKey is a SECRET.
SNAPTRADE_CLIENT_ID=your_client_id_here
SNAPTRADE_CONSUMER_KEY=your_consumer_key_here

# ── Database ────────────────────────────────────────────────────────────────
# Set to a Postgres connection string in production. Without it, state is a local
# JSON file (fine for dev, wiped on redeploy).
# DATABASE_URL=postgres://...

# ── Email (verification + password reset via Resend) ────────────────────────
# Without a key, links are logged to the server console instead of emailed.
# RESEND_API_KEY=your_resend_key
# MAIL_FROM=Steward <hello@yourdomain.com>

# Public base URL for links in emails (defaults to RENDER_EXTERNAL_URL, then localhost).
# APP_URL=https://your-app.onrender.com

# Set to 1 only when running behind a trusted, TLS-terminating proxy (e.g. Render),
# so X-Forwarded-For can be trusted for rate-limiting.
# TRUST_PROXY=1
